# Praxis configuration.
#
# Copy to `.env` and edit. Every PRAXIS_* name below maps to a field on
# `praxis.config.Settings`; the values shown are the built-in defaults
# unless marked REQUIRED. Anything left unset simply stays off - a
# connector without credentials reports itself unavailable and the rest
# of the system starts normally.

# ============================ REQUIRED ==============================

# The only setting with no default. Must be an async SQLAlchemy URL.
PRAXIS_DATABASE_URL=postgresql+asyncpg://praxis:praxis@localhost:5433/praxis


# ========================== MODEL PROVIDER ==========================
# At least one key is needed for planning, synthesis and answering.
# The SDKs read these directly - they are not PRAXIS_ prefixed.

ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Which model serves which purpose. The provider is derived from the
# model id: `claude-*` goes to Anthropic, `gpt-*`/`o1`/`o3`/`o4` to
# OpenAI, so switching provider is this line and nothing else.
# Purposes: planning, routing, code_synthesis, answering, diagnosis, vision.
# PRAXIS_LLM_MODEL_OVERRIDES={"planning":"gpt-5","routing":"gpt-4.1-mini"}


# ============================ SECURITY ==============================

# Off by default: every request runs as a single local operator. Turn on
# to require an API key per request and resolve a real per-user
# principal with RBAC. Create keys with `python -m praxis.cli key-issue`.
PRAXIS_AUTH_ENABLED=false

# Generated code is refused at execution until a human approves its
# exact hash. Leave on unless you fully control every intent submitted.
PRAXIS_REQUIRE_SKILL_APPROVAL=true

# How long a pending approval stays valid.
PRAXIS_APPROVAL_TTL_SECONDS=3600
PRAXIS_APPROVAL_TIMEOUT_SECONDS=3600


# =========================== ORCHESTRATION ==========================

# Times a failed plan is re-planned with the failure as context.
PRAXIS_MAX_REPLAN_ATTEMPTS=2

# Have a model judge whether a finished result actually answers the
# intent before reporting success. Costs one extra call per task.
PRAXIS_VERIFY_COMPLETION=false

# Keep a finished task's checkpoints so its run stays replayable.
PRAXIS_RETAIN_CHECKPOINTS_AFTER_COMPLETION=true

# Extra directory scanned for SKILL.md procedures, beyond the built-ins.
# PRAXIS_PROCEDURES_DIR=/etc/praxis/procedures


# ============================= SANDBOX ==============================
# Synthesized code is validated in a throwaway container.

PRAXIS_SANDBOX_TIMEOUT_SECONDS=30

# Only needed when Docker is not on the default socket (common on
# Windows/WSL, where `tcp://localhost:2375` is typical). The Docker SDK
# also honours a plain DOCKER_HOST; this one takes precedence.
# PRAXIS_DOCKER_HOST=tcp://localhost:2375


# ============================= STORAGE ==============================

# Uploaded attachments and rendered artifacts. Local filesystem unless
# an S3 bucket is set below.
PRAXIS_BLOB_STORE_ROOT=./data/attachments

# Distributed cache. Unset uses an in-process cache, which is a real
# implementation - fine for a single instance.
# PRAXIS_REDIS_URL=redis://localhost:6379/0
PRAXIS_REDIS_NAMESPACE=praxis

# S3-compatible blob storage (needs the `s3` extra).
# PRAXIS_S3_BUCKET=
# PRAXIS_S3_ENDPOINT_URL=https://s3.example.com   # MinIO, R2, ...
# PRAXIS_S3_REGION=us-east-1
# PRAXIS_S3_KEY_PREFIX=                           # NOT a tenant boundary


# ============================ RESILIENCE ============================

PRAXIS_CONNECTOR_CIRCUIT_BREAKER_ENABLED=true
PRAXIS_CONNECTOR_FAILURE_THRESHOLD=5
PRAXIS_CONNECTOR_CIRCUIT_RESET_SECONDS=30.0
# PRAXIS_CONNECTOR_RATE_LIMIT_PER_SECOND=10

PRAXIS_HEALTH_SCAN_INTERVAL_SECONDS=300
PRAXIS_SCHEDULE_POLL_INTERVAL_SECONDS=60


# ============================ CONNECTORS ============================
# All optional. Each registers only when its settings are present.

# -- Metrics ---------------------------------------------------------
# PRAXIS_PROMETHEUS_URL=http://localhost:9090

# -- HTTP APIs -------------------------------------------------------
# PRAXIS_REST_BASE_URL=https://api.example.com
# PRAXIS_REST_AUTH_HEADER_NAME=Authorization
# PRAXIS_REST_AUTH_HEADER_VALUE=Bearer xxx

# PRAXIS_GRAPHQL_URL=https://api.example.com/graphql
# PRAXIS_GRAPHQL_AUTH_HEADER_NAME=Authorization
# PRAXIS_GRAPHQL_AUTH_HEADER_VALUE=Bearer xxx

# -- SaaS ------------------------------------------------------------
# PRAXIS_GITHUB_TOKEN=ghp_xxx
# PRAXIS_SLACK_BOT_TOKEN=xoxb-xxx

# -- Databases (each needs its own extra installed) -------------------
# PRAXIS_MONGODB_URI=mongodb://localhost:27017
# PRAXIS_MONGODB_DATABASE=praxis

# PRAXIS_ELASTICSEARCH_URL=http://localhost:9200
# PRAXIS_ELASTICSEARCH_API_KEY=

# PRAXIS_NEO4J_URI=neo4j://localhost:7687
# PRAXIS_NEO4J_USER=neo4j
# PRAXIS_NEO4J_PASSWORD=
# PRAXIS_NEO4J_DATABASE=

# -- S3 as a queryable connector (distinct from blob storage above) ---
# PRAXIS_S3_CONNECTOR_ACCESS_KEY_ID=
# PRAXIS_S3_CONNECTOR_SECRET_ACCESS_KEY=
# PRAXIS_S3_CONNECTOR_ENDPOINT_URL=
# PRAXIS_S3_CONNECTOR_REGION=us-east-1
# PRAXIS_S3_CONNECTOR_BUCKET=

# -- MCP servers ------------------------------------------------------
# A JSON array. Each entry is stdio (`command` + `args`) or HTTP (`url`).
# `read_only_tools` lists tools safe for the read path on servers that
# do not annotate their own tools.
# PRAXIS_MCP_SERVERS=[{"name":"everything","command":"npx","args":["-y","@modelcontextprotocol/server-everything"]}]


# ============================ WEB TOOLS =============================
# Off by default. When enabled, fetches are restricted to URLs that
# already appeared in the task's prior context.

PRAXIS_WEB_TOOLS_ENABLED=false
# PRAXIS_TAVILY_API_KEY=
